<div class="card" style="max-width:560px; margin:var(--space-12) auto;">
  <div style="text-align:center; padding:var(--space-8);">
    <div class="success-icon" style="background:var(--color-danger-bg); color:var(--color-danger); margin:0 auto var(--space-5);">
      <i class="ph ph-warning-circle"></i>
    </div>
    <div class="success-title" style="color:var(--color-danger);">An Error Occurred</div>
    <div class="success-body"><%= message %></div>
    <div class="flex gap-3" style="justify-content:center; margin-top:var(--space-5);">
      <a href="/" class="btn btn-primary"><i class="ph ph-house"></i> Home</a>
      <button onclick="history.back()" class="btn btn-ghost"><i class="ph ph-arrow-left"></i> Go Back</button>
    </div>
  </div>
</div>
